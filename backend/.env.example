# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_technology
DB_USER=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------
# Frontend URL
# -----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Google OAuth (for social login)
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------------
# SMTP Email Service (Nodemailer) — PRIMARY email provider
# ─────────────────────────────────────────────────────────────────────
# Supports any SMTP provider: Gmail, Outlook, SendGrid, Zoho SMTP, etc.
#
# Provider quick-reference
#   Gmail SMTP      → smtp.gmail.com    / 587  (STARTTLS) / 465 (SSL)
#   Outlook/SMTP    → smtp.office365.com / 587
#   SendGrid        → smtp.sendgrid.net / 587
#   Zoho SMTP       → smtp.zoho.com     / 465
#   Mailgun         → smtp.mailgun.org  / 587
#
# Run: npm install nodemailer
# -----------------------------------------------------------------------
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASS>
SMTP_SECURE=false          # true → SSL (port 465); false → STARTTLS (port 587)
SMTP_FROM_NAME=Smart Technology
SMTP_FROM_EMAIL=<FROM_EMAIL_ADDRESS>

# Admin email (recipient for contact form & admin notifications)
ADMIN_EMAIL=admin@smarttech.com

# -----------------------------------------------------------------------
# WhatsApp API (for phone verification via OTP)
# -----------------------------------------------------------------------
# To obtain credentials:
#   1. Create a Meta developer account at https://developers.facebook.com/
#   2. Create a new app and add WhatsApp product
#   3. Get your Phone Number ID and Access Token
# -----------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=https://api.facebook.com/v21.0
