# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_technology
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------------------
# Zoho Mail API (email sending)
# ---------------------------------------------------------------
# To obtain credentials, follow these steps:
#   1. Go to https://admin-console.zoho.com/ and sign in
#   2. Navigate to Mail → Settings → SMTP & IMAP
#   3. Enable SMTP access and generate an OAuth refresh token
#   4. Get your account ID from Mail → Domains
# ---------------------------------------------------------------
ZOHO_EMAIL=
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE_URL=https://mail.zoho.com
ZOHO_OAUTH_BASE_URL=https://accounts.zoho.com

# Admin email (recipient for contact form & admin notifications)
ADMIN_EMAIL=admin@smarttech.com

# ---------------------------------------------------------------
# WhatsApp API (for phone verification via OTP)
# ---------------------------------------------------------------
# To obtain credentials:
#   1. Create a Meta developer account at https://developers.facebook.com/
#   2. Create a new app and add WhatsApp product
#   3. Get your Phone Number ID and Access Token
# ---------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=https://api.facebook.com/v21.0
